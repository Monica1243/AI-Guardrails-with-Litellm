# Copy this file to .env and fill in your values
# cp .env.example .env

# API key for the LiteLLM proxy
LITELLM_MASTER_KEY=sk-your-master-key-here

# Host port to expose the LiteLLM proxy on
LITELLM_PORT=4000

# Host port to expose Ollama on
OLLAMA_PORT=11434

# Ollama model used for AI validators
# Must match a model available in your Ollama instance
OLLAMA_MODEL=llama3.2:3b

# Ollama API base URL (use the Docker service name when running via docker compose)
OLLAMA_HOST=http://ollama:11434
